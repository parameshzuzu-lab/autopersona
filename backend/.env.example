# Backend Environment Configuration
PROJECT_NAME="AutoPersona AI"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_USER=autopersona
POSTGRES_PASSWORD=autopersonapass
POSTGRES_DB=autopersona_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://autopersona:autopersonapass@localhost:5432/autopersona_db

# AI Provider API Keys
GEMINI_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="optional-openai-api-key"

# Autonomous Persona Configurations
AUTONOMOUS_INTERVAL_MINUTES=30
SIMULATION_MODE=false
MIN_QUALITY_SCORE=7.0
