# Backend Environment Configuration
PROJECT_NAME="AutoPersona AI"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_USER=autopersona
POSTGRES_PASSWORD=autopersonapass
POSTGRES_DB=autopersona_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://autopersona:autopersonapass@localhost:5432/autopersona_db

# AI Provider API Keys
# The chat uses the FIRST configured provider in this order:
#   1) Microsoft Azure OpenAI / Azure AI Foundry (preferred)
#   2) Google Gemini
#   3) OpenAI
# Without any key the chat runs in "offline safe mode" (honest, no fabricated facts).

# --- Microsoft Azure OpenAI / Azure AI Foundry ---
# Create a resource in the Azure portal or AI Foundry, deploy a model, then copy
# "Endpoint" and "Key 1" from "Keys and Endpoint". Set AZURE_OPENAI_DEPLOYMENT to
# the exact deployment name you created (NOT the raw model name unless identical).
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_DEPLOYMENT="your-deployment-name"
AZURE_OPENAI_API_VERSION="2024-12-01"

# --- Google Gemini ---
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash"

# --- OpenAI (optional fallback) ---
OPENAI_API_KEY="optional-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Chat engine tuning
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_RESPONSE_CHARS=8000

# Autonomous Persona Configurations
AUTONOMOUS_INTERVAL_MINUTES=30
SIMULATION_MODE=false
MIN_QUALITY_SCORE=7.0
